import random


secret_number = random.randint(1, 10)

print(secret_number)

def guessNumber(n):
    for i in range(10):
        number = int(input("Guess the number (1-10): "))

        if number > 10:
            print("Please enter a number between 1 and 10")
            continue
        if number == n:
            print("Hurrah!!!! Number matched")
            break
        else: 
            print(f"{number} does not match with {n}")
        
            


guessNumber(secret_number)